PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-07

# SumUp Payments
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# SumUp test
SUMUP_SANDBOX_API_KEY=
SUMUP_SANDBOX_MERCHANT_CODE=
SUMUP_SANDBOX=true

# Canonical public origin only (HTTPS, no path/query), e.g. https://example.com
SITE_URL=

# Shopify Admin API (order creation)
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07

# SumUp webhook + checkout mode
SUMUP_WEBHOOK_SECRET=
PUBLIC_CHECKOUT_MODE=shopify

# Upstash Redis (dedupe lock + session KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ops alerting (paid-but-no-order runbook)
ALERT_WEBHOOK_URL=
# Analytics (GA4 + Microsoft Clarity)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CLARITY_PROJECT_ID=
