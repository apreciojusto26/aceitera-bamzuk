---
import { product } from '@/data/product';
import { CartButton } from '@/components/islands/CartButton';

const commerceEnabled = product.commerce.shopifyHandle.trim().length > 0;
---

<header class="sticky top-9 z-40 border-b border-graphite/5 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex h-14 w-full max-w-[80rem] items-center justify-between px-5">
    <a href="/" class="font-display text-xl font-black leading-none tracking-tight text-graphite">
      {product.brand}
    </a>

    <div>{commerceEnabled && <CartButton client:load />}</div>
  </div>
</header>
