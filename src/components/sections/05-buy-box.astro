---
import { BundleSelector } from '@/components/islands/BundleSelector';
import Stars from '@/components/ui/Stars.astro';
import { getProductCommerce } from '@/lib/shopify/catalog';
import { product } from '@/data/product';

const commerceEnabled = product.commerce.shopifyHandle.trim().length > 0;
const commerce = commerceEnabled ? await getProductCommerce() : null;
const popularPack = product.packs.find((pack) => pack.popular) ?? product.packs[0];
const giftThresholdUnits = popularPack?.units ?? 1;
const ratingLabel = product.ratingAverage.toFixed(1).replace('.', ',');
const ratingCountLabel = new Intl.NumberFormat('es-ES').format(product.ratingCount);
---

<section id="buy" class="min-w-0 scroll-mt-14 bg-white">
  <div class="mx-auto w-full max-w-[28rem] px-5 pb-8 pt-3 md:max-w-[42rem] xl:max-w-[64rem]">
    <div class="rounded-card bg-surface p-5 shadow-[0_-5px_22px_-10px_rgb(30_33_36_/_0.32),0_8px_28px_-8px_rgb(30_33_36_/_0.22)]">
      <p class="text-eyebrow font-bold uppercase text-grape">Utensilio de cocina 2 en 1</p>
      <h2 class="mt-2 text-display">{commerce?.title ?? product.name}</h2>
      <p class="mt-3 text-sm leading-relaxed text-graphite/80">{product.subtagline}</p>

      <div class="mt-3 flex items-center gap-2">
        <Stars rating={product.ratingAverage} />
        <span class="text-xs font-semibold text-graphite">{ratingLabel}/5 ({ratingCountLabel})</span>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-3">
        {
          product.heroPills.map((label) => (
            <span class="rounded-tile bg-grape-tint px-3 py-2 text-center text-xs font-semibold text-grape-deep">
              {label}
            </span>
          ))
        }
      </div>

      {
        commerce ? (
          <div class="mt-6">
            <BundleSelector
              client:visible
              commerce={commerce}
              packs={[...product.packs]}
              bundleOfferActive={product.commerce.bundleOfferActive}
              variantGroupLabel={product.variantGroupLabel}
              cta={{
                primary: product.cta.primary,
                checkout: product.cta.checkout,
                pending: product.cta.pending,
                soldOut: product.cta.soldOut,
              }}
              errors={product.errors}
              giftThresholdUnits={giftThresholdUnits}
              giftLabel="Progreso de tu selección"
            />
          </div>
        ) : (
          <div class="mt-6 rounded-tile border border-gold/40 bg-gold-tint p-4" role="status">
            <p class="font-display text-base font-bold text-graphite">Compra online desactivada</p>
            <p class="mt-1 text-sm text-steel">
              No hay un producto, variantes ni precios reales verificados en Shopify. La página permanece en modo catálogo para evitar pedidos con datos inventados.
            </p>
          </div>
        )
      }

      <dl class="mt-5 space-y-2 text-sm">
        {
          product.specs.map((spec) => (
            <div class="flex justify-between gap-4 border-b border-graphite/10 pb-2 last:border-0">
              <dt class="text-steel">{spec.label}</dt>
              <dd class="text-right font-semibold text-graphite">{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
