---
import Container from '@/components/ui/Container.astro';
import { product } from '@/data/product';

const commerceEnabled = product.commerce.shopifyHandle.trim().length > 0;

const columns = [
  {
    title: 'Producto',
    links: ['Cómo funciona', 'Preguntas frecuentes'],
  },
  {
    title: 'Estado',
    links: commerceEnabled ? ['Compra disponible', 'Carrito y checkout activos'] : ['Catálogo informativo', 'Compra desactivada'],
  },
  {
    title: 'Transparencia',
    links: ['Reseñas conservadas de la fuente', 'Sin garantías inventadas'],
  },
];
---

<footer class="bg-graphite py-10 text-xs text-bone/70">
  <Container>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div>
        <span class="font-display text-lg font-black tracking-tight text-bone">
          {product.brand}
        </span>
      </div>
      {
        columns.map((column) => (
          <div>
            <p class="mb-2 font-semibold text-bone">{column.title}</p>
            <ul class="space-y-1.5">
              {column.links.map((link) => (
                <li>
                  <span>{link}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 border-t border-white/10 pt-6 text-bone/50">
      Ficha basada en los recursos del producto. OLZURA es la marca visible en esta landing. Los precios, el carrito y el checkout solo se activan con comercio real verificado.
    </p>
  </Container>
</footer>
