---
import { product } from '@/data/product';

const ticker = product.trustTicker;
// Two identical halves + `translate3d(-50%)` keyframe = seamless loop.
// Each half is repeated enough times to stay wider than any viewport:
// a half narrower than the screen leaves blank space while scrolling.
const half = Array.from({ length: 6 }, () => ticker).flat();
const loop = [...half, ...half];
---

<div class="sticky top-0 z-50 flex h-9 items-center overflow-hidden bg-grape-deep text-[0.75rem] font-bold text-white" aria-label={ticker.join(' · ')}>
  <div class="flex w-max animate-marquee motion-reduce:animate-none">
    {
      loop.map((item, index) => (
        <span class="flex shrink-0 items-center whitespace-nowrap pe-10" aria-hidden={index >= ticker.length || undefined}>
          {item}
        </span>
      ))
    }
  </div>
</div>
