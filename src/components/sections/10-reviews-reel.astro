---
import Container from '@/components/ui/Container.astro';
import WaveDivider from '@/components/ui/WaveDivider.astro';
import { ReviewCarousel } from '@/components/islands/ReviewCarousel';
import { testimonials } from '@/data/testimonials';

const reelReviews = testimonials.filter((t) => t.variant === 'reel');
---

<Fragment>
  <div class="bg-white">
    <WaveDivider fill="grape-tint" flip />
  </div>

  <section id="opiniones" class="scroll-mt-24 bg-white py-10 md:py-14">
    <Container>
      <div>
        <p class="text-eyebrow font-bold uppercase text-grape">Opiniones del producto</p>
        <h2 class="mt-1 text-display md:text-4xl">Reseñas conservadas de la fuente</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-steel">
          Textos, puntuaciones, autores y fechas proceden del scrape asociado a este producto. No afirmamos verificación ni ubicación cuando la fuente no las aporta.
        </p>
      </div>
    </Container>

    <div class="relative left-1/2 mt-6 w-screen -translate-x-1/2">
      <ReviewCarousel client:visible reviews={reelReviews} />
    </div>
  </section>
</Fragment>
