---
import Container from '@/components/ui/Container.astro';
import { ICONS } from '@/lib/icons';
import { product } from '@/data/product';

const shield = ICONS.shield;
const { guarantee } = product;
---

<section id="garantia" class="bg-gold-tint py-12 md:py-16" aria-labelledby="guarantee-title">
  <Container class="text-center">
    <div class="mx-auto grid size-24 place-items-center rounded-full border border-gold/30 bg-white shadow-card">
      <svg viewBox={shield.viewBox} class="size-14 text-gold" aria-hidden="true">
        <path fill="currentColor" d={shield.path} />
      </svg>
    </div>
    <h2 id="guarantee-title" class="mt-4 text-display md:text-4xl">{guarantee.title}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-steel">{guarantee.text}</p>

    <div class="mx-auto mt-8 grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-3">
      {
        guarantee.points.map((point) => (
          <div class="flex flex-col items-center gap-2 rounded-tile border border-gold/20 bg-white/70 p-4 text-xs leading-relaxed text-graphite">
            <svg viewBox={shield.viewBox} class="size-6 text-gold" aria-hidden="true">
              <path fill="currentColor" d={shield.path} />
            </svg>
            <span>{point}</span>
          </div>
        ))
      }
    </div>
  </Container>
</section>
